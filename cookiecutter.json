{
  "ifdd_proxy_prj_name": "IFDD Proxy",
  "ifdd_proxy_prj_slug": "{{ cookiecutter.ifdd_proxy_prj_name|lower|replace(' ', '_') }}",
  "ifdd_proxy_traefik_version": "v3.7.16",
  "ifdd_proxy_host": "proxy",
  "ifdd_proxy_dashboard_user": "admin",
  "ifdd_proxy_port": "80",
  "ifdd_proxy_tls_port": "443",
  "ifdd_proxy_log_level": "WARN",
  "ifdd_proxy_network": "proxy-net",
  "ifdd_proxy_internal_hosts": "",
  "ifdd_proxy_memory_limit": "512M",
  "ifdd_proxy_enable_tls": "y",
  "ifdd_proxy_tls_min_version": [
    "VersionTLS13",
    "VersionTLS12"
  ],
  "ifdd_proxy_default_cert_file": "default.crt",
  "ifdd_proxy_default_key_file": "default.key",
  "ifdd_proxy_enable_letsencrypt": "n",
  "ifdd_proxy_letsencrypt_email": "admin@example.org",
  "ifdd_proxy_letsencrypt_staging": "n",
  "ifdd_proxy_alias_headers_strategy": [
    "delete",
    "reject",
    "keep"
  ],
  "ifdd_proxy_trusted_ips": "",
  "ifdd_proxy_enable_socket_proxy": "n",
  "ifdd_proxy_socket_proxy_image": "ghcr.io/tecnativa/docker-socket-proxy:v0.5.0",
  "ifdd_proxy_enable_dos_baseline": "y",
  "ifdd_proxy_enable_security_headers": "y",
  "ifdd_proxy_frame_options": "SAMEORIGIN",
  "ifdd_proxy_referrer_policy": "no-referrer",
  "ifdd_proxy_enable_hsts": "n",
  "ifdd_proxy_hsts_seconds": "31536000",
  "ifdd_proxy_csp_api": "default-src 'none'; frame-ancestors 'none'",
  "ifdd_proxy_csp_api_docs": "default-src 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:",
  "ifdd_proxy_csp_ui": "default-src 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'",
  "ifdd_proxy_dos_rate_average": "50",
  "ifdd_proxy_dos_rate_period": "1s",
  "ifdd_proxy_dos_rate_burst": "100",
  "ifdd_proxy_dos_inflight_amount": "20",
  "ifdd_proxy_dos_ipv6_subnet": "64",
  "ifdd_proxy_dos_enable_buffering": "y",
  "ifdd_proxy_dos_max_request_body_bytes": "2000000",
  "ifdd_proxy_dos_mem_request_body_bytes": "262144",
  "ifdd_proxy_dos_max_header_bytes": "32768",
  "ifdd_proxy_dos_h2_max_streams": "100",
  "ifdd_proxy_dos_read_timeout": "15s",
  "ifdd_proxy_dos_write_timeout": "30s",
  "ifdd_proxy_dos_idle_timeout": "5s",
  "ifdd_proxy_enable_oauth2_proxy": "n",
  "ifdd_proxy_oauth2_proxy_image": "quay.io/oauth2-proxy/oauth2-proxy:v7.15.5-alpine",
  "ifdd_proxy_oauth2_proxy_ca_file": "",
  "ifdd_proxy_oidc_issuer": "https://keycloak.example.org/realms/ifdd",
  "ifdd_proxy_oidc_client_id": "ifdd-proxy",
  "_copy_without_render": [
    ".github",
    "tests"
  ]
}
